{
  "name": "lead-studio",
  "version": "2.0.0",
  "description": "Lead Studio Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "rebuild": "electron-builder --win --publish=never"
  },
  "author": "Lead Studio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "express": "^4.18.2",
    "duckdb": "^0.9.2",
    "cors": "^2.8.5",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.leadstudio.app",
    "productName": "Lead Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "ui/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  }
}
